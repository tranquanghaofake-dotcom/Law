# Sao chép thành .env rồi điền. Không commit .env lên git.

# --- LLM (OpenAI-compatible) ---
# Để trống = chế độ DEMO tự bật. Điền key thật (sk-...) để gọi LLM.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com
# Ollama local: LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama

# --- Threads API (Meta for Developers) ---
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- Reddit API (https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=legal-content-pipeline/0.1 by u/your_username

# --- YouTube Data API v3 (Google Cloud Console) ---
YOUTUBE_API_KEY=

# --- TikTok Content Posting API (chỉ khi publish.mode=tiktok) ---
TIKTOK_ACCESS_TOKEN=

# --- Review UI ---
REVIEW_PASSWORD=doi-mat-khau-nay
