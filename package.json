{
  "name": "luyen-luat-monorepo",
  "private": true,
  "version": "2.1.0",
  "description": "Luyện Luật — web học khái niệm luật (apps/web) và kho nội dung luật (packages/content)",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @luyen-luat/web",
    "build": "npm run build -w @luyen-luat/web",
    "preview": "npm run preview -w @luyen-luat/web",
    "content": "npm run build -w @luyen-luat/content",
    "test": "npm test -ws --if-present",
    "check": "npm run check -ws --if-present",
    "e2e": "npm run test:e2e -w @luyen-luat/web",
    "shots": "node tools/screenshots.cjs",
    "ci": "npm run content && npm run check && npm test && npm run build"
  }
}
